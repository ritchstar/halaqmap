+
+/* بطاقات المنتج بصورة كاملة — تستبدل صفوف القائمة القديمة */
+
+.solution-catalog__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
+  gap: 20px;
+  margin-top: 16px;
+}
+
+.solution-catalog__card-button {
+  display: block;
+  width: 100%;
+  padding: 0;
+  border: 0;
+  appearance: none;
+  background: transparent;
+  color: inherit;
+  text-align: start;
+  font: inherit;
+  cursor: pointer;
+}
+
+.solution-catalog__card-button:focus-visible {
+  outline: 2px solid var(--sc-brick);
+  outline-offset: 5px;
+}
+
+.solution-catalog__card {
+  position: relative;
+  isolation: isolate;
+  min-height: 22rem;
+  overflow: hidden;
+  border: 1px solid var(--sc-border);
+  background: var(--sc-ink);
+  color: var(--sc-light);
+  border-radius: 2px;
+  box-shadow: 6px 6px 0 var(--sc-index);
+  transition: transform 220ms ease, box-shadow 220ms ease;
+}
+
+.solution-catalog__card-button:hover .solution-catalog__card,
+.solution-catalog__card-button:focus-visible .solution-catalog__card {
+  transform: translate(-2px, -2px);
+  box-shadow: 9px 9px 0 var(--sc-index);
+}
+
+.solution-catalog__card-image,
+.solution-catalog__card-fallback,
+.solution-catalog__card-wash {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+
+.solution-catalog__card-image {
+  z-index: -2;
+  display: block;
+  object-fit: cover;
+  object-position: center;
+  transition: transform 600ms var(--ease-out);
+}
+
+.solution-catalog__card-button:hover .solution-catalog__card-image {
+  transform: scale(1.035);
+}
+
+.solution-catalog__card-fallback {
+  z-index: -2;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--sc-stripe, var(--sc-blue));
+}
+
+.solution-catalog__card-fallback span {
+  font-size: 4rem;
+  font-weight: 700;
+  color: var(--sc-light);
+  opacity: 0.85;
+}
+
+.solution-catalog__card-wash {
+  z-index: -1;
+  background:
+    linear-gradient(180deg, rgba(16, 31, 39, 0.16) 0%, rgba(16, 31, 39, 0.06) 36%, rgba(16, 31, 39, 0.84) 100%),
+    linear-gradient(90deg, rgba(16, 31, 39, 0.1), transparent 48%, rgba(16, 31, 39, 0.22));
+}
+
+.solution-catalog__card-meta,
+.solution-catalog__card-content {
+  position: absolute;
+  right: 0;
+  left: 0;
+  z-index: 1;
+}
+
+.solution-catalog__card-meta {
+  top: 0;
+  display: flex;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 1.1rem 1.2rem;
+  font-size: 0.68rem;
+  letter-spacing: 0.08em;
+}
+
+.solution-catalog__card-category {
+  border: 1px solid rgba(247, 244, 237, 0.42);
+  padding: 0.28rem 0.5rem;
+  background: rgba(29, 79, 105, 0.32);
+}
+
+.solution-catalog__card-content {
+  bottom: 0;
+  padding: 1.25rem 1.2rem 1.4rem;
+}
+
+.solution-catalog__card-latin {
+  display: block;
+  margin-bottom: 0.45rem;
+  color: rgba(247, 244, 237, 0.7);
+  font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
+  font-size: 0.67rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+
+.solution-catalog__card-title {
+  display: flex;
+  align-items: baseline;
+  gap: 0.35rem;
+  margin: 0;
+  font-size: clamp(1.75rem, 4.5vw, 2.75rem);
+  line-height: 0.95;
+  letter-spacing: -0.06em;
+}
+
+.solution-catalog__card-title-classic {
+  font-family: Georgia, 'Times New Roman', serif;
+  font-weight: 700;
+}
+
+.solution-catalog__card-title-modern {
+  font-family: Arial, 'Segoe UI', sans-serif;
+  font-size: 0.68em;
+  font-weight: 800;
+  letter-spacing: -0.04em;
+  color: var(--sc-stripe, var(--sc-brick));
+}
+
+.solution-catalog__card-summary {
+  max-width: 32rem;
+  margin: 0.8rem 0 0;
+  color: rgba(247, 244, 237, 0.82);
+  font-size: 0.9rem;
+  line-height: 1.7;
+}
+
+.solution-catalog__card--brick {
+  --sc-stripe: var(--sc-brick);
+}
+
+.solution-catalog__card--blue {
+  --sc-stripe: var(--sc-blue);
+}
+
+.solution-catalog__card--yellow {
+  --sc-stripe: var(--sc-yellow);
+}
+
+@media (max-width: 640px) {
+  .solution-catalog__card {
+    min-height: 19rem;
+  }
+
+  .solution-catalog__card-summary {
+    font-size: 0.82rem;
+  }
+}
