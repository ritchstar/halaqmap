diff --git a/src/components/store/catalog/SolutionCatalogProductCard.tsx b/src/components/store/catalog/SolutionCatalogProductCard.tsx
new file mode 100644
index 0000000..56035c9
--- /dev/null
+++ b/src/components/store/catalog/SolutionCatalogProductCard.tsx
@@ -0,0 +1,61 @@
+/**
+ * Copyright © 2026 HalaqMap. All Rights Reserved.
+ *
+ * بطاقة منتج بصورة كاملة لفهرس خريطة الحل — تستبدل صف القائمة القديم
+ * (ProductMark + نص) ببطاقة صورة تعبيرية واحدة تمثّل هوية/نشاط المنتج،
+ * مع اسم المنتج مركّبًا فوقها بخط يمزج بين الطابع الكلاسيكي والحديث.
+ */
+import { STORE_SOLUTION_CATALOG_COPY, type SolutionCatalogProduct } from '@/config/storeSolutionCatalog';
+import { sanitizeStoreProductImageSrc } from '@/lib/storeDisallowedImagery';
+
+type SolutionCatalogProductCardProps = {
+  product: SolutionCatalogProduct;
+  onOpen: (product: SolutionCatalogProduct) => void;
+};
+
+export function SolutionCatalogProductCard({ product, onOpen }: SolutionCatalogProductCardProps) {
+  const safeImage = sanitizeStoreProductImageSrc(product.cardImageSrc);
+  const numeralMatch = product.nameAr.match(/[0-9]/);
+  const classicName = product.nameAr.replace(/[0-9]/g, '');
+  const firstCharacter = product.nameAr.trim().charAt(0) || '؟';
+
+  return (
+    <button
+      type="button"
+      className={`solution-catalog__card-button solution-catalog__card--${product.stripe}`}
+      onClick={() => onOpen(product)}
+      aria-label={`${STORE_SOLUTION_CATALOG_COPY.openCardAr}: ${product.nameAr}`}
+    >
+      <article className="solution-catalog__card">
+        {safeImage ? (
+          <img
+            className="solution-catalog__card-image"
+            src={safeImage}
+            alt={`صورة ${product.nameAr}`}
+            loading="lazy"
+            decoding="async"
+          />
+        ) : (
+          <div className="solution-catalog__card-fallback" aria-hidden="true">
+            <span>{firstCharacter}</span>
+          </div>
+        )}
+        <div className="solution-catalog__card-wash" aria-hidden="true" />
+        <div className="solution-catalog__card-meta">
+          <span className="solution-catalog__code">{product.code}</span>
+          <span className="solution-catalog__card-category">{product.categoryAr}</span>
+        </div>
+        <div className="solution-catalog__card-content">
+          <span className="solution-catalog__card-latin">{product.nameEn}</span>
+          <h3 className="solution-catalog__card-title">
+            <span className="solution-catalog__card-title-classic">{classicName}</span>
+            {numeralMatch ? (
+              <span className="solution-catalog__card-title-modern">{numeralMatch[0]}</span>
+            ) : null}
+          </h3>
+          <p className="solution-catalog__card-summary">{product.summaryAr}</p>
+        </div>
+      </article>
+    </button>
+  );
+}
