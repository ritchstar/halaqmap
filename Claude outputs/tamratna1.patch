+
+          <div>
+            <h2 className="text-xl font-extrabold text-[#f4efe4]">{STORE_DATES_LIVE.extensionTitleAr}</h2>
+            <p className={`mt-2 ${proseSm}`}>{STORE_DATES_LIVE.extensionLeadAr}</p>
+            <div className="mt-5 max-w-2xl">
