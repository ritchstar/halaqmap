+  }
+  const featuredCount = state.shelf.filter((item) => item.featured).length;
+  return {
+    ...state,
+    shelf: [
+      ...state.shelf,
+      {
+        catalogId: catalog.id,
+        nameAr: catalog.nameAr,
+        category: catalog.category,
