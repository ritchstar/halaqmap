+  const existing = state.shelf.find((item) => item.catalogId === catalogId);
+  if (existing) {
+    return {
+      ...state,
+      shelf: state.shelf.map((item) =>
+        item.catalogId === catalogId
+          ? { ...item, inStock: true, arrivedToday: true, price: price ?? item.price }
