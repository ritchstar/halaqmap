+/**
+ * Copyright © 2026 HalaqMap. All Rights Reserved.
+ *
+ * صندوق ملاحظة تمرتنا1 — مدرج، ليست غرفة عامة.
+ */
+import { useState } from 'react';
+import { STORE_DATES_LIVE } from '@/config/storeDatesLive';
+import type { DatesChatMsg, DatesLabState } from '@/lib/storeDatesLiveLab';
+
+export function StoreDatesBuyerChat({
+  state,
+  onChange,
+}: {
+  state: DatesLabState;
+  onChange: (next: DatesLabState) => void;
+}) {
+  const [name, setName] = useState('');
+  const [text, setText] = useState('');
+  if (state.chatIncluded === false) return null;
+
+  function send() {
+    const body = text.trim();
+    if (body.length < 2) return;
+    const msg: DatesChatMsg = {
+      id: `${Date.now()}`,
+      from: 'buyer',
+      name: name.trim().slice(0, 40) || 'عميل',
+      text: body.slice(0, 240),
+      at: new Date().toISOString(),
+    };
+    onChange({ ...state, chats: [msg, ...state.chats].slice(0, 200) });
+    setText('');
+  }
+
+  return (
+    <section className="mt-6 rounded-2xl border border-[#8A6239]/25 bg-[#1a140c]/80 p-4">
+      <h3 className="font-extrabold">{STORE_DATES_LIVE.chatBuyerTitleAr}</h3>
+      <p className="mt-1 text-xs leading-6 text-white/60">{STORE_DATES_LIVE.chatBuyerHintAr}</p>
+      <label className="mt-3 block text-sm">
+        {STORE_DATES_LIVE.chatBuyerNameLabelAr}
+        <input className="dates-field" value={name} onChange={(e) => setName(e.target.value)} />
+      </label>
+      <label className="mt-3 block text-sm">
+        {STORE_DATES_LIVE.chatBuyerFieldLabelAr}
+        <textarea
+          className="dates-field min-h-24 py-2"
+          value={text}
+          maxLength={240}
+          onChange={(e) => setText(e.target.value)}
+        />
+      </label>
+      <button
+        type="button"
+        onClick={send}
+        className="mt-3 rounded-full bg-[#8A6239] px-4 py-2 text-sm font-bold text-[#061018]"
+      >
+        {STORE_DATES_LIVE.chatBuyerSendAr}
+      </button>
+    </section>
+  );
+}
+
+export function StoreDatesDeskChat({
+  state,
+  onChange,
+}: {
+  state: DatesLabState;
+  onChange: (next: DatesLabState) => void;
+}) {
+  const [reply, setReply] = useState('');
+  if (state.chatIncluded === false) return null;
+  const visible = state.chats.filter((item) => !item.hidden).slice(0, 30);
+
+  function sendReply() {
+    const body = reply.trim();
+    if (body.length < 2) return;
+    const msg: DatesChatMsg = {
+      id: `${Date.now()}`,
+      from: 'desk',
+      name: state.host.hostName || 'الصندوق',
+      text: body.slice(0, 240),
+      at: new Date().toISOString(),
+    };
+    onChange({ ...state, chats: [msg, ...state.chats].slice(0, 200) });
+    setReply('');
+  }
+
+  function hide(id: string) {
+    onChange({
+      ...state,
+      chats: state.chats.map((item) => (item.id === id ? { ...item, hidden: true } : item)),
+    });
+  }
+
+  return (
+    <section className="rounded-2xl border border-[#8A6239]/25 bg-[#1a140c]/80 p-4">
+      <h3 className="font-extrabold">{STORE_DATES_LIVE.chatDeskTitleAr}</h3>
+      <ul className="mt-3 space-y-2 text-sm">
+        {visible.map((item) => (
+          <li key={item.id} className="rounded-xl border border-white/10 bg-black/30 p-3">
+            <p className="text-xs text-white/50">{item.from === 'desk' ? 'المشغّل' : 'العميل'} · {item.name}</p>
+            <p className="mt-1 leading-7">{item.text}</p>
+            <button type="button" className="mt-2 text-xs text-white/45 underline" onClick={() => hide(item.id)}>
+              إخفاء
+            </button>
+          </li>
+        ))}
+      </ul>
+      <label className="mt-3 block text-sm">
+        {STORE_DATES_LIVE.chatDeskReplyAr}
+        <textarea className="dates-field min-h-20 py-2" value={reply} onChange={(e) => setReply(e.target.value)} />
+      </label>
+      <button
+        type="button"
+        onClick={sendReply}
+        className="mt-3 rounded-full bg-[#8A6239] px-4 py-2 text-sm font-bold text-[#061018]"
+      >
+        إرسال الرد
+      </button>
+    </section>
+  );
+}
