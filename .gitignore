# --- Dependencies ---
node_modules/
jspm_packages/

# --- Package manager caches / debug logs ---
.npm/
.pnpm-store/
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*

# --- Logs & diagnostics ---
logs/
*.log
report.[0-9]*.json

# --- Runtime data / pids ---
pids/
*.pid
*.seed
*.pid.lock

# --- Env files (keep examples) ---
.env
.env.*
!.env.example
!.env.*.example
!.env.local.example

# --- Coverage ---
coverage/
.nyc_output/

# --- Build outputs / caches ---
*.tar.gz
*.tgz
dist/
build/
electron-dist/
dist-electron/
out/
bin/
.tmp/
tmp/
temp/
.cache/
.esbuild/
.esbuild-cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.vite/
.vite-inspect/

# --- TypeScript ---
*.tsbuildinfo

# --- Common web frameworks ---
.next/
.nuxt/
.svelte-kit/
.storybook-out/
storybook-static/
.angular/
.docusaurus/
.vercel/
.netlify/
.output/

# --- E2E / testing artifacts ---
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/
cypress/downloads/

# --- Editors & OS junk ---
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.iml
.vs/
*.swp
.DS_Store
Thumbs.db
# Microsoft Office lock/temp files (e.g. ~$Document.docx)
~$*
.node_repl_history

# --- Uploaded Files ---
uploaded_files/

# --- Secret Admin Files ---
ADMIN_ACCESS.md
SECRET_*.md
.agent_secrets.env
provision_agent.ps1.txt
build-log.txt
.vercel

# --- Android signing (never commit private keys) ---
*.keystore
*.jks
android-partner-twa/android.keystore
android-partner-twa/*.keystore
android-partner-twa/android-keys.env
android-partner-twa/android-keys.env.txt
android-partner-twa/passwords.txt
android-partner-twa/local.properties

# --- Android TWA build artifacts ---
android-partner-twa/.gradle/
android-partner-twa/**/build/
android-partner-twa/*.apk
android-partner-twa/*.aab
play-store/delivery/*.aab
play-store/delivery/*.apk
android-partner-twa/*.idsig
android-partner-twa/manifest-checksum.txt
android-partner-twa/app/src/main/res/raw/

# --- iOS Capacitor consumer shell ---
ios/App/Pods/
ios/App/App/public/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/App/App/capacitor.config.json
*.ipa
*.dSYM.zip

# --- Fazaa consented partners (generated at build from accepted consents) ---
scripts/data/fazaaFeaturedPartners.consented.json

# --- SAIP source archives (local upload binaries) ---
fkrih/saip-*/**/*.zip
fkrih/saip-*/**/*.pdf
*.zip
!public/**/*.zip


