/**
 * خلل حقيقي ثانٍ مؤكَّد بفحص مباشر + قياس تخطيط دقيق (بعد إصلاح تراكب شريط
 * الموقع في patch 0046): صف أزرار التواصل أسفل بطاقة الحلاق في نتائج البحث
 * (الموقع + حجز متقدم + هاتف + واتساب + محادثة) — `<div className="flex gap-2">`
 * بلا `flex-wrap` — قد يفيض أفقياً خارج حدود الشاشة على الجوال، فيختفي أحد
 * الأزرار (عادة واتساب، وأحياناً جزء من زر الهاتف) عن الرؤية والوصول تماماً.
 *
 * مؤكَّد بقياس تخطيط حقيقي عبر متصفح الجوال: أعدت بناء نفس صف الأزرار
 * (بنفس أصناف Tailwind الفعلية المُصرَّفة في `Button`: `whitespace-nowrap`
 * + `px-4 py-2` للأزرار النصية flex-1، و`h-10 w-10` لأزرار الأيقونات) داخل
 * حاوية بعرض ٣٥٠px (نفس عرض محتوى البطاقة الفعلي المقيس مباشرة) — النتيجة:
 * الصف بالكامل (٥ أزرار) يشغل ٣٥٠px بالضبط بلا أي هامش أمان — أي انحراف
 * بسيط (خط مختلف قليلاً بين Safari/Chrome، جهاز أضيق، أو تفعيل زر خامس عبر
 * showChat) يكفي لدفع المحتوى خارج حدود الشاشة فعلياً. مؤكَّد أيضاً بلقطتي
 * شاشة حيتين من نفس المستخدم على صالون حقيقي: ظهر زر الهاتف مقصوصاً جزئياً
 * عند حافة الشاشة اليسرى واختفى زر واتساب بالكامل.
 *
 * الإصلاح: `flex-wrap` على صف الأزرار في جميع بطاقات المستويات الأربعة
 * (البرونزي بلافتة، البرونزي العادي، الذهبي، الماسي) — فأي زر لا يتّسع
 * ينزل لسطر جديد بدل أن يُقصّ أو يختفي خارج حدود الشاشة. تحقّق تجريبي:
 * نفس صف الأزرار الخماسي مع flex-wrap يوزَّع تلقائياً على سطرين ضمن نفس
 * حاوية ٣٥٠px بلا أي فيضان.
 *
 * تشغيل: npx tsx scripts/test-barber-card-button-row-wrap-2026-09-22.mts
 */
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const src = readFileSync(join(root, 'src/components/BarberCards.tsx'), 'utf8');

// ── ١) لا يجب أن يبقى أي صف أزرار بلا flex-wrap ─────────────────────────
const bareFlexGap2 = src.match(/className="flex gap-2"/g) || [];
assert.equal(
  bareFlexGap2.length,
  0,
  `لا يجب أن يبقى أي "flex gap-2" بلا flex-wrap — بقي ${bareFlexGap2.length} مرة (قد يفيض أفقياً على الجوال)`,
);

// ── ٢) يجب أن تظهر flex-wrap gap-2 أربع مرات بالضبط — واحدة لكل بطاقة
//    مستوى (برونزي بلافتة، برونزي عادي، ذهبي، ماسي) — لا أقل ولا أكثر ────
const wrappedRows = src.match(/className="flex flex-wrap gap-2"/g) || [];
assert.equal(
  wrappedRows.length,
  4,
  `يجب أن تظهر "flex flex-wrap gap-2" في جميع بطاقات المستويات الأربعة — وُجدت ${wrappedRows.length} فقط`,
);

console.log('✅ إصلاح فيضان صف أزرار بطاقة الحلاق (flex-wrap) موثَّق ومُتحقَّق منه بالكامل.');
