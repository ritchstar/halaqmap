/**
 * خلل حقيقي رابع مؤكَّد بمحاكاة حسابية دقيقة لقصّ bg-cover (نفس خوارزمية
 * CSS background-size:cover) على الأبعاد الفعلية لصورة خلفية الهيرو
 * (landing-hero-barbershop.webp — 2848×1600px، نسبة عرض/ارتفاع ≈1.78) مقابل
 * حاوية الهيرو على الجوال (طويلة وضيقة، نسبة ~0.49 تقريباً لأن القسم
 * `min-h-[100svh]`-مكافئ على الجوال أيضاً بفعل الحشوة + المحتوى):
 *
 * bg-cover + bg-center (السلوك الأصلي) يقصّ حول *مركز* الصورة أفقياً حصراً
 * — وهذا بالضبط موضع اللوح الزجاجي الفارغ المتعمَّد وسط الصورة (مُعَدّ أصلاً
 * لاستضافة نص فوقه في اللقطات الأفقية على الحاسوب) — فيظهر على الجوال حصراً
 * كسطح ضبابي شبه عديم التفاصيل، يزداد قتامة فوق طبقتي التعتيم الحاليتين حتى
 * يبدو "مظلماً ومقتطَعاً بلا معنى". مؤكَّد بلقطتي المستخدم الحيتين (لقطة من
 * الموقع الفعلي على الجوال + لقطة مكبَّرة لنفس المنطقة توضح تفصيلاً غنياً —
 * كرسي حلاقة + معلّقات ذهبية + رف عطور — غير ظاهر إطلاقاً في القصّ الحالي)،
 * وبمحاكاة بايثون مباشرة تعيد بناء نفس قصّ bg-cover رياضياً من الصورة
 * الأصلية ثم تركّب طبقتي التعتيم الفعليتين (بلا أي تعديل عليهما) فوقه —
 * النتيجة مطابقة بصرياً للقطتي المستخدم.
 *
 * الإصلاح: بدلاً من bg-center (٥٠٪ أفقياً)، استخدام bg-position مخصَّص —
 * 10% أفقياً على الجوال فقط (desktop/!isMobile يبقى center دون تغيير، لأن
 * نسبة حاوية الحاسوب أقرب لنسبة الصورة نفسها فتظهر الصورة بعرضها الكامل
 * تقريباً هناك أصلاً بلا هذه المشكلة). محاكاة الإحداثية 10% تُظهر بدلاً من
 * اللوح الزجاجي الفارغ: الكرسي + الإضاءة الذهبية + المرآة + الرف — بتباين
 * كافٍ للنص الأبيض فوق طبقتي التعتيم نفسيهما (لم تُعدَّلا إطلاقاً).
 *
 * تشغيل: npx tsx scripts/test-hero-mobile-bg-position-2026-09-22.mts
 */
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const src = readFileSync(join(root, 'src/pages/LandingPreview.tsx'), 'utf8');

// ── ١) عزل حاوية خلفية الهيرو المصوَّرة (div الذي يحمل backgroundImage
//    الخاص بـ landing-hero-barbershop.webp) لفحصها تحديداً ──────────────
const heroBgDivMatch = src.match(
  /<div\s+className="pointer-events-none absolute inset-0 z-0 bg-cover"[\s\S]{0,400}?landing-hero-barbershop\.webp[\s\S]{0,300}?\/>/,
);
assert.ok(
  heroBgDivMatch,
  'يجب العثور على حاوية خلفية الهيرو المصوَّرة (landing-hero-barbershop.webp) بصيغتها المُصلَحة',
);
const heroBgDiv = heroBgDivMatch![0];

// ── ٢) لا يجب أن تبقى bg-center ثابتة في className — القصّ يجب أن يختلف
//    بين الجوال والحاسوب الآن ───────────────────────────────────────────
assert.ok(
  !/className="[^"]*\bbg-center\b[^"]*"/.test(heroBgDiv),
  'يجب ألا تبقى bg-center ثابتة في className — bg-position يجب أن تُحدَّد ديناميكياً حسب isMobile',
);

// ── ٣) backgroundPosition الديناميكي معرَّف بالشرط الصحيح: 10% على الجوال،
//    center على الحاسوب — كلاهما ضمن نفس div الخلفية المصوَّرة ──────────
assert.match(
  heroBgDiv,
  /backgroundPosition:\s*isMobile\s*\?\s*'10% center'\s*:\s*'center'/,
  "يجب تعريف backgroundPosition: isMobile ? '10% center' : 'center' داخل حاوية خلفية الهيرو تحديداً",
);

// ── ٤) الصورة وbg-cover نفسيهما لم يتغيّرا (لا حاجة لأصل جديد) ──────────
assert.match(
  heroBgDiv,
  /landing-hero-barbershop\.webp/,
  'يجب أن تبقى نفس صورة الخلفية المستخدمة (لا حاجة لأصل جديد — إصلاح موضعي فقط)',
);
assert.match(heroBgDiv, /\bbg-cover\b/, 'يجب أن يبقى bg-cover كما هو (قصّ الصورة نفسه لم يتغيّر، فقط موضعه الأفقي)');

// ── ٥) طبقتا التعتيم (العمودية والأفقية) لم تُعدَّلا إطلاقاً — الإصلاح
//    موضعي على الصورة فقط، لا على التعتيم فوقها ─────────────────────────
assert.match(
  src,
  /linear-gradient\(180deg, rgba\(6,12,10,0\.62\) 0%, rgba\(8,14,12,0\.5\) 32%, rgba\(10,15,13,0\.58\) 68%, #eee2ce 100%\)/,
  'يجب أن تبقى طبقة التعتيم العمودية دون أي تعديل',
);
assert.match(
  src,
  /linear-gradient\(90deg, rgba\(6,12,10,0\.55\) 0%, rgba\(6,12,10,0\.1\) 45%, rgba\(6,12,10,0\.35\) 100%\)/,
  'يجب أن تبقى طبقة التعتيم الأفقية دون أي تعديل',
);

console.log('✅ إصلاح موضع خلفية الهيرو المصوَّرة على الجوال (bg-position بديل) موثَّق ومُتحقَّق منه بالكامل.');
