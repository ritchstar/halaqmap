# انسخ هذا الملف إلى android-keys.env (محلي فقط — لا يُرفع لـ Git)
# ثم املأ كلمتي المرور نفسهما المستخدمتين عند إنشاء android.keystore
# (سلّمهما لك المساعد التقني في المحادثة عند توليد المفتاح لأول مرة — احفظهما في مدير كلمات مرور).

STORE_FILE=../android.keystore
KEY_ALIAS=halaqmap-chess-key
STORE_PASSWORD=REPLACE_ME
KEY_PASSWORD=REPLACE_ME
